# Copy this file to .env and fill in real values. .env is git-ignored; this file is not — keep
# placeholders here, never real secrets.

# TMDB (themoviedb.org) — free "API Read Access Token" under Settings > API. Used to search for
# and download poster/banner/logo artwork server-side (apps/api only, never sent to the client).
TMDB_API_KEY=
TMDB_API_READ_ACCESS_KEY=

# Fanart.tv — free personal API key from fanart.tv/webservice/register. Used as a supplemental
# source for high-quality transparent logo artwork.
FANART_API_KEY=

# Where uploaded/ingested poster, banner, and logo artwork lives on disk — outside the repo and
# outside apps/web, like a Jellyfin media directory. Defaults to repo-root data/media(/uploads),
# already git-ignored, if left unset; only worth setting explicitly for a Docker volume mount or
# a NAS-mounted path. ARCADIA_PUBLIC_MEDIA_ROOT only needs setting separately if it should differ
# from ARCADIA_MEDIA_ROOT's parent (see apps/api/src/media-storage.ts).
ARCADIA_MEDIA_ROOT=
ARCADIA_PUBLIC_MEDIA_ROOT=

ARCADIA_STREAM_ADDON_URL=https://torrentio.strem.fun
ARCADIA_STREAM_ADDON_CONFIG=qualityfilter=cam,480p
ARCADIA_STREAM_TIMEOUT_MS= # Upstream timeout (default `8000`)
ARCADIA_STREAM_CACHE_TTL_MS= # In-process response cache (default 15 min), so two family members opening the same film make one addon call.
ARCADIA_STREAM_PREFERRED_HEIGHT= # Preferred vertical resolution (default `1080`). Ranking prefers the best release at or below this and treats anything larger as a last resort — a 4K remux will not reach first frame quickly on a family connection.
ARCADIA_STREAM_ALLOW_TMDB_IDS=false # `true` lets `tmdb:` ids be sent when no IMDb id exists. Off by default until the addon is confirmed to accept them: a deployment that does not returns an empty list, which looks like "no sources" rather than "wrong id".

# OpenSubtitles REST v1 — free account key from opensubtitles.com/en/consumers (the newer
# key-based API, not the deprecated XML-RPC one). Used server-side (apps/api only) to search for
# and download subtitles for the desktop player. Absent means the subtitle menu reports "no
# source configured" rather than failing obscurely — playback itself is unaffected either way.
OPENSUBTITLES_API_KEY=
# Optional; OpenSubtitles asks integrations to identify themselves. Defaults to "Arcadia v2" if
# left unset.
OPENSUBTITLES_USER_AGENT=

# --- docker-compose only — devenv supplies its own equivalents, ignore these for local dev ---

# Generate with `openssl rand -base64 32`. Required in production (the API refuses to start
# without it) — this signs session cookies, so treat it like any other secret.
BETTER_AUTH_SECRET=
# Postgres password for the db container. Anything long and random; only the api/migrate
# containers ever need to know it.
POSTGRES_PASSWORD=
# Your server's LAN address and the *web* container's published port (docker-compose.yml maps
# it to 8080) — the API's CORS check only accepts requests whose origin matches this.
ARCADIA_WEB_URL=http://192.168.1.50:8080
# Your server's LAN address and the *api* container's published port (3001) — baked into the web
# build at image-build time, so rebuild apps/web's image if this ever changes.
VITE_API_URL=http://192.168.1.50:3001
