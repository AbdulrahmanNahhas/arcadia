{
  "name": "@arcadia/api",
  "version": "2.0.0",
  "description": "Hono and OpenAPI service for the Arcadia v2 catalog.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@arcadia/contracts": "workspace:*",
    "@arcadia/database": "workspace:*",
    "@arcadia/domain": "workspace:*",
    "@better-auth/drizzle-adapter": "^1.6.29",
    "@hono/node-server": "^1.19.9",
    "@hono/zod-openapi": "^1.2.2",
    "better-auth": "^1.6.29",
    "hono": "^4.11.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22",
    "tsup": "^8.5.1",
    "tsx": "^4.23.1",
    "typescript": "^6",
    "vitest": "^4.0.18"
  }
}
