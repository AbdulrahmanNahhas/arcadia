{
  "inlay_hints": {
    "enabled": false
  },
  "lsp": {
    "oxlint": {
      "initialization_options": {
        "settings": {
          "configPath": null,
          "run": "onSave",
          "disableNestedConfig": false
        }
      }
    },
    "oxfmt": {
      "initialization_options": {
        "settings": {
          "fmt.configPath": null
        }
      }
    }
  },
  "languages": {
    "JavaScript": {
      "format_on_save": "on",
      "formatter": {
        "language_server": {
          "name": "oxfmt"
        }
      },
      "language_servers": ["oxfmt", "oxlint", "vtsls", "..."]
    },
    "TypeScript": {
      "format_on_save": "on",
      "formatter": {
        "language_server": {
          "name": "oxfmt"
        }
      },
      "language_servers": ["oxfmt", "oxlint", "vtsls", "..."]
    },
    "TSX": {
      "format_on_save": "on",
      "formatter": {
        "language_server": {
          "name": "oxfmt"
        }
      },
      "language_servers": ["oxfmt", "oxlint", "vtsls", "..."]
    },
    "JSON": {
      "format_on_save": "on",
      "formatter": {
        "language_server": {
          "name": "oxfmt"
        }
      },
      "language_servers": ["oxfmt", "..."]
    },
    "JSONC": {
      "format_on_save": "on",
      "formatter": {
        "language_server": {
          "name": "oxfmt"
        }
      },
      "language_servers": ["oxfmt", "..."]
    },
    "CSS": {
      "format_on_save": "on",
      "formatter": "language_server",
      "language_servers": ["...", "oxfmt"]
    },
    "HTML": {
      "format_on_save": "on",
      "formatter": "language_server"
    },
    "Markdown": {
      "format_on_save": "on",
      "formatter": "language_server"
    },
    "TOML": {
      "format_on_save": "on",
      "formatter": "language_server"
    },
    "YAML": {
      "format_on_save": "on",
      "formatter": "language_server"
    },
    "Rust": {
      "format_on_save": "on",
      "formatter": "language_server",
      "tab_size": 2
    }
  }
}
