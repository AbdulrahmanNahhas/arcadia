# Goes in ~/.config/systemd/user/ next to arcadia-backup.timer. Runs the drill every Sunday
# morning, after the nightly backup has landed.
[Unit]
Description=Weekly Arcadia backup restore drill

[Timer]
OnCalendar=Sun *-*-* 05:00:00
Persistent=true
RandomizedDelaySec=15m
Unit=arcadia-restore-drill.service

[Install]
WantedBy=timers.target
