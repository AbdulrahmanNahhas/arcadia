# Copy to ~/.config/arcadia/arcadia.env on the server and `chmod 600` it. Read by every Quadlet
# unit in deploy/quadlet. Never commit the filled-in file.

# Postgres password for the arcadia-db container. Anything long and random.
POSTGRES_PASSWORD=change-me
# The API's connection string — host is the db container's name on the arcadia network.
DATABASE_URL=postgresql://arcadia:change-me@arcadia-db/arcadia

# Generate with `openssl rand -base64 32`. Signs session cookies/tokens; the API refuses to
# start in production without it.
BETTER_AUTH_SECRET=

# Your server's LAN address and the web container's published port. Better Auth trusts this
# origin (plus the desktop app's fixed origin) for sign-in.
ARCADIA_WEB_URL=http://192.168.1.50:23180

# Optional integrations — same meaning as in .env.example at the repo root.
TMDB_API_KEY=
TMDB_API_READ_ACCESS_KEY=
FANART_API_KEY=
OPENSUBTITLES_API_KEY=
ARCADIA_STREAM_ADDON_URL=
ARCADIA_STREAM_ADDON_CONFIG=qualityfilter=cam,480p
ARCADIA_STREAM_ALLOW_TMDB_IDS=false
