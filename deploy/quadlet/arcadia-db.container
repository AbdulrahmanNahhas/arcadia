[Unit]
Description=Arcadia PostgreSQL
After=network-online.target

[Container]
ContainerName=arcadia-db
Image=docker.io/library/postgres:17
AutoUpdate=registry
Network=arcadia.network
Volume=arcadia-pgdata.volume:/var/lib/postgresql/data
EnvironmentFile=%h/.config/arcadia/arcadia.env
Environment=POSTGRES_DB=arcadia
Environment=POSTGRES_USER=arcadia
# POSTGRES_PASSWORD comes from arcadia.env.
HealthCmd=pg_isready -U arcadia
HealthInterval=5s
HealthTimeout=5s
HealthRetries=10
# systemd only reports the unit as started once the healthcheck passes, so the api unit's
# After= genuinely waits for a ready database.
Notify=healthy
# Not published: the API reaches it over the arcadia network, and nothing on the LAN should.
# For the CLI/psql from the laptop, use an SSH tunnel (README "Working against the server").
#
# Sized for a small family box (4–8 GB RAM, one API). Postgres' defaults assume 128 MB of
# shared buffers, which is far too little to keep the whole catalog in memory. Raise
# shared_buffers to ~25% of RAM and effective_cache_size to ~50% if the box has more.
Exec=postgres -c shared_buffers=256MB -c effective_cache_size=1GB -c work_mem=16MB -c maintenance_work_mem=128MB -c random_page_cost=1.1 -c log_min_duration_statement=500ms

[Service]
Restart=always
TimeoutStartSec=120

[Install]
WantedBy=default.target
