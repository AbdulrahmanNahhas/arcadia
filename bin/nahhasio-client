#!/usr/bin/env bash
# Run from the repository devenv shell; package assets before starting the native window.
set -euo pipefail
task_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$task_root"
pnpm --filter @nahhasio/linux-ui build
cargo build --locked -p nahhasio-linux
exec bash "$task_root/bin/nahhasio-native-runtime" "$task_root/target/debug/nahhasio-linux" "$@"
