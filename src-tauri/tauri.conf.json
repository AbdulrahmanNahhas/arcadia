{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Arcadia",
  "version": "0.1.0",
  "identifier": "com.arcadia.desktop",
  "build": {
    "frontendDist": "../apps/web/dist/client",
    "devUrl": "http://127.0.0.1:3000",
    "beforeDevCommand": "pnpm --filter @arcadia/web dev",
    "beforeBuildCommand": "pnpm --filter @arcadia/web build"
  },
  "app": {
    "windows": [
      {
        "title": "Arcadia",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "transparent": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* http://localhost:*; media-src 'self' http://127.0.0.1:* blob:; img-src 'self' data: blob: http://127.0.0.1:* https:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'; frame-src https://www.youtube-nocookie.com https://www.youtube.com"
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/AbdulrahmanNahhas/arcadia/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY5NDhBOTA1MEVEMjA3QUUKUldTdUI5SU9CYWxJYVdYNENWUE5yRGl5aTVhZ2Zhc2x1QTQvWWRqZjloTXVUM0VYa3l5L1BkWWwK"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb", "rpm"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "linux": {
      "deb": {
        "depends": ["libmpv2 | libmpv1", "libva2", "libgl1"]
      },
      "rpm": {
        "depends": ["mpv-libs", "libva", "mesa-libGL"]
      }
    }
  }
}
