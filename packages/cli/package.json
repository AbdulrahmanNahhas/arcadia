{
  "name": "@arcadia/cli",
  "version": "2.0.0",
  "description": "Agent-facing command line interface for reading, editing, and reporting on the Arcadia v2 PostgreSQL catalog.",
  "private": true,
  "type": "module",
  "bin": {
    "arcadia": "./src/main.ts"
  },
  "exports": {
    ".": "./src/main.ts"
  },
  "scripts": {
    "arcadia": "tsx src/main.ts",
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@arcadia/contracts": "workspace:*",
    "@arcadia/database": "workspace:*",
    "@arcadia/domain": "workspace:*",
    "postgres": "^3.4.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22",
    "tsx": "^4.23.1",
    "typescript": "^6",
    "vitest": "^4.0.18"
  }
}
